<?xml version="1.0" encoding="utf-8"?>
<!-- Sculpted widget panel: the night-earth photo under a navy wash.
     Opacity variants are swapped by WidgetStyle at runtime. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#04070F" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:alpha="0.50">
        <bitmap
            android:src="@drawable/widget_bg_image"
            android:gravity="top|center_horizontal"
            android:scaleType="centerCrop" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#730C1832"
                android:endColor="#8C04070F"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#8025F4C8" />
        </shape>
    </item>
</layer-list>
