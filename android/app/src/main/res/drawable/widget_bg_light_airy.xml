<?xml version="1.0" encoding="utf-8"?>
<!-- Light-mode widget panel (airy, CC alpha head).
     Same rounded shape as the dark panel, tinted for daylight so the
     neon-on-navy colours never become unreadable on a pale wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#CCFFFFFF"
        android:centerColor="#CCF4F8FC"
        android:endColor="#CCE6EEF6"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#B30E9E86" />
</shape>
