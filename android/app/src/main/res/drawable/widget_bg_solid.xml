<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent widget panel (near-solid, F2 alpha head).
     No bitmap layer here on purpose: a bitmap inside a layer-list is not
     clipped by <corners>, which is what produced the little triangular
     spurs poking out of the four rounded corners. A plain gradient shape
     is always clipped correctly, so the corners stay perfectly round.
     WidgetStyle swaps between the four variants at runtime. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#F20C1832"
        android:centerColor="#F2081020"
        android:endColor="#F204070F"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#8025F4C8" />
</shape>
